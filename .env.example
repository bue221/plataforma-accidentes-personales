# Copie este archivo a `.env` (ignorado por git) y ajuste los valores.
# Todos los valores son ficticios. Nunca versione credenciales reales.

# --- Servidor HTTP (apps/api) ---
# development | test | production
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# --- PostgreSQL (lo usan docker-compose.yml y apps/api) ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=accidentes
DB_NAME_TEST=accidentes_test
DB_USER=accidentes_app
# Obligatoria: la API y docker compose fallan al arrancar si falta.
DB_PASSWORD=cambie-esta-clave-local

# --- Frontend (apps/web) ---
# Solo variables públicas con prefijo VITE_: terminan embebidas en el bundle del navegador.
VITE_API_BASE_URL=/api
